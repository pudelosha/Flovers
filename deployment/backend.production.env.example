# Merge these entries into the existing PRIVATE environment; do not discard
# database, SMTP, Firebase or other deployment-specific settings.
APP_ENV=production
DEBUG=False
LOAD_DOTENV=False
SECRET_KEY=
JWT_SIGNING_KEY=
ALLOWED_HOSTS=api.flovers.app
SITE_URL=https://api.flovers.app
PUBLIC_WEB_BASE=https://api.flovers.app

# Choose the actual proxy peer. Empty means no forwarded headers are trusted.
# Host Caddy: inspect the peer seen inside Docker first.
# Example Docker Traefik peer ONLY: TRUSTED_PROXY_CIDRS=172.29.0.2/32
TRUSTED_PROXY_CIDRS=

# Shared by every web worker; separate from Celery Redis DBs 0 and 1.
THROTTLE_CACHE_URL=redis://redis:6379/2
EMAIL_TIMEOUT=30

# Empty selects the generated firmware's bundled ISRG Root X1/X2 CA bundle.
# For another issuer, supply its CA PEM using deployment-supported multiline
# environment/secrets injection before generating replacement firmware.
IOT_TLS_CA_CERT=
